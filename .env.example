# Copy to .env and edit. NEVER commit .env.
# ---- core ----
APP_ENV=development                          # production: refuses mock LLM + macOS say, weak secrets, disables /docs
DATABASE_URL=postgresql+psycopg://studio:studio@localhost:5432/cyber_studio
POSTGRES_PASSWORD=change-me-too            # used by docker compose
SECRET_KEY=generate-with-openssl-rand-hex-32
SERVICE_TOKEN=generate-with-openssl-rand-hex-32   # bearer token n8n uses; cannot approve anything
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=                        # set once to bootstrap the admin user, then you may clear it
CORS_ORIGINS=http://localhost:3000

# ---- AI (MODE A = leave LLM_PROVIDER=mock and paste JSON manually; MODE B = anthropic|ollama) ----
LLM_PROVIDER=mock                            # mock | ollama | anthropic   (mock is rejected when APP_ENV=production)
LLM_FALLBACK_PROVIDER=                       # e.g. ollama: used if the primary fails
ANTHROPIC_API_KEY=                           # developer API key from console.anthropic.com (Claude Pro is NOT an API key)
ANTHROPIC_MODEL=claude-sonnet-5-5
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- voice / avatar ----
VOICE_PROVIDER=kokoro                        # piper | macos_say (dev only) | elevenlabs | auto
KOKORO_VOICE=am_michael                    # see voice/README.md for the list; KOKORO_SPEED=1.0
PIPER_BINARY=piper
PIPER_MODEL=                                 # path to en_US-*.onnx
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AVATAR_PROVIDER=static                       # static | musetalk | heygen
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
MUSETALK_DIR=

# ---- rendering ----
RENDER_ENGINE=ffmpeg                         # ffmpeg | remotion

# ---- YouTube (see docs/YOUTUBE_SETUP.md) ----
YOUTUBE_CLIENT_SECRETS=                      # path to OAuth client JSON
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/youtube/oauth/callback

# ---- n8n ----
N8N_ENCRYPTION_KEY=generate-with-openssl-rand-hex-16
# n8n owner account is created in the browser on first visit (http://localhost:5678)
NOTIFY_WEBHOOK_URL=                          # optional Slack/Discord/ntfy-compatible webhook
STUDIO_DASHBOARD_URL=http://localhost:3000
