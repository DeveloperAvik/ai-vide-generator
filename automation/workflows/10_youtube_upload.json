        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.STUDIO_SERVICE_TOKEN }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $workflow.name }}-{{ $execution.id }}"
            }
          ]
        },
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ stage: \"n8n:youtube_upload\", level: \"error\", lesson_id: $(\"Webhook\").item.json.body.lesson_id ?? null, message: JSON.stringify($json).slice(0, 1500) }) }}"
